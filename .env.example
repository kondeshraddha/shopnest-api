# ===========================
# APPLICATION
# ===========================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=ShopNest API
FRONTEND_URL=http://localhost:4000

# ===========================
# DATABASE (PostgreSQL)
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=shopnest_db
DB_LOGGING=true

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# MAIL (SMTP)
# ===========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=ShopNest <noreply@shopnest.com>

# ===========================
# STRIPE PAYMENTS
# ===========================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================
# FILE UPLOAD
# ===========================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# ===========================
# RATE LIMITING
# ===========================
THROTTLE_TTL=60
THROTTLE_LIMIT=100